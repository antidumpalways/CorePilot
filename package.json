{
  "name": "corepilot",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "dev:api": "pnpm --filter @corepilot/api dev",
    "dev:executor": "pnpm --filter @corepilot/executor dev",
    "dev:web": "pnpm --filter @corepilot/web dev",
    "contracts:build": "cd packages/contracts && forge build",
    "contracts:test": "cd packages/contracts && forge test"
  }
}
