# CorePilot Web — environment
# Copy to `.env` (Vite only exposes variables prefixed with VITE_).

# REST API base URL (may be down — the UI falls back to DEMO DATA).
VITE_API_URL=http://localhost:8001

# Elysium testnet
# VITE_ values are visible to every browser user. Use a domain-restricted,
# disposable RPC key for local demos; do not put a private production key here.
VITE_ELYSIUM_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
VITE_ELYSIUM_CHAIN_ID=99801

# Contract addresses (filled after deploy; leave blank to run in read-only/demo mode)
VITE_PILOT_TOKEN_ADDRESS=
VITE_STAKING_ADDRESS=
VITE_STRATEGY_REGISTRY_ADDRESS=
VITE_EXECUTION_CONTROLLER_ADDRESS=
VITE_MARKET_DATA_ORACLE_ADDRESS=
VITE_FEE_MODULE_ADDRESS=
VITE_RECEIPT_REGISTRY_ADDRESS=

# Never put agent private keys or executor secrets in VITE_ variables.
