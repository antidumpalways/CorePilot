# PostgreSQL required for policies, authorizations and runtime records.
# Without it the API remains read-only/fail-closed. Never commit a real password.
DATABASE_URL=postgresql://corepilot:corepilot@localhost:5432/corepilot

# API server port
API_PORT=8001
API_HOST=127.0.0.1

# Opt-in watcher. Requires a verified executor public address and agent enrollment.
WATCHER_ENABLED=false
WATCHER_POLL_MS=15000
RUNTIME_ORDER_NOTIONAL_USD=12
RUNTIME_LEVERAGE_BPS=100
RUNTIME_SLIPPAGE_BPS=50
EXECUTOR_ADDRESS=

# Elysium testnet policy layer
ELYSIUM_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
ELYSIUM_CHAIN_ID=99801

# Copy verified deployment addresses from local deployment manifest / executor .env.
PILOT_TOKEN_ADDRESS=
STAKING_ADDRESS=
STRATEGY_REGISTRY_ADDRESS=
EXECUTION_CONTROLLER_ADDRESS=
MARKET_DATA_ORACLE_ADDRESS=
FEE_MODULE_ADDRESS=
RECEIPT_REGISTRY_ADDRESS=

# Public HyperCore mainnet signal URL is pinned in API source.
# Testnet execution-agent secret belongs only in the executor environment, never here.
