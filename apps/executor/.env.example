# Elysium
ELYSIUM_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
ELYSIUM_CHAIN_ID=99801

# Hyperliquid
HYPERLIQUID_API_URL=https://api.hyperliquid-testnet.xyz

# Separate HyperCore Testnet order worker. Default off; no mainnet order fallback.
# Agent key is a TESTNET DEVELOPMENT SECRET, never a master-wallet seed/key.
# Set DATABASE_URL locally to the CorePilot development PostgreSQL URL.
DATABASE_URL=
HYPERCORE_TESTNET_AGENT_PRIVATE_KEY=
EXECUTOR_ENABLE_TESTNET_ORDERS=false

# Scheduler
EXECUTOR_POLL_MS=15000
EXECUTOR_ENABLE_LIVE_EXECUTION=false

# Deterministic local demo only. NEVER used as a live on-chain strategy policy.
FUNDING_TRIGGER_BPS=-1
STRATEGY_SIDE=long

# Keys (only needed for live execution / snapshot signing)
EXECUTOR_PRIVATE_KEY=
ORACLE_SIGNER_PRIVATE_KEY=

# Contract addresses
PILOT_TOKEN_ADDRESS=
STAKING_ADDRESS=
STRATEGY_REGISTRY_ADDRESS=
EXECUTION_CONTROLLER_ADDRESS=
FEE_MODULE_ADDRESS=
MARKET_DATA_ORACLE_ADDRESS=
RECEIPT_REGISTRY_ADDRESS=
